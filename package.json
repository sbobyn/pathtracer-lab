  },
  "dependencies": {
    "@nybobs/editor-ui": "file:vendor/nybobs-editor-ui-0.0.0.tgz",
    "gsap": "^3.12.5",
    "html2canvas": "^1.4.1",
    "picomatch": "^4.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.177.0",
    "troika-three-text": "^0.52.5"
